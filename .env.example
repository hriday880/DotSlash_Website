# Turso Database
VITE_TURSO_DATABASE_URL="https://your-db-name.turso.io"
VITE_TURSO_AUTH_TOKEN="your-turso-auth-token"

# Cloudinary (Image Uploads)
VITE_CLOUDINARY_CLOUD_NAME="your-cloud-name"
VITE_CLOUDINARY_UPLOAD_PRESET="your-upload-preset"

# Admin Portal (In-house auth)
# Generate hash using: echo -n "your_password" | shasum -a 256
VITE_ADMIN_PASSWORD_HASH="your-sha256-hash-here"

# Medium Blog
VITE_MEDIUM_USERNAME="@your_medium_username"
