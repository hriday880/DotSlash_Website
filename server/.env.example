# Shared `dotslash` Turso DB. Its token is public (it's in the site bundle), so
# the API signs every lt_bookings row with SIGNING_SECRET and ignores tampered rows.
TURSO_DATABASE_URL="libsql://dotslash-hriday880.aws-ap-northeast-1.turso.io"
TURSO_AUTH_TOKEN=""
# 32+ random chars. Never change it once bookings exist — old rows would stop verifying.
SIGNING_SECRET=""
# UPI account that receives payments (shown on the page + encoded in the QR)
UPI_ID="yourname@okaxis"
UPI_NAME="Name on the UPI account"
# Comma-separated one-time 10%-off codes
PROMO_CODES=""
# Password for /laser-tag/admin (verify payments, check-in)
ADMIN_PASSWORD=""
# Comma-separated site origins allowed to call the API
ALLOWED_ORIGINS="https://<your-domain>,http://localhost:5173"
# Set to "false" to stop new online bookings
BOOKINGS_OPEN="true"
